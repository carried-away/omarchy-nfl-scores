#!/bin/bash

set -euo pipefail

API="https://site.api.espn.com/apis/site/v2/sports/football/nfl/scoreboard"
SUMMARY_API="https://site.api.espn.com/apis/site/v2/sports/football/nfl/summary"
CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/omarchy"
CACHE_FILE="$CACHE_DIR/nflscores.json"
CACHE_TTL=30
MAX_RESPONSE_BYTES=1048576
MAX_EVENTS=100
OPERATION_TIMEOUT=20
DEADLINE=$((SECONDS + OPERATION_TIMEOUT))

mkdir -p "$CACHE_DIR"

if [[ -f "$CACHE_FILE" ]]; then
  age=$(( $(date +%s) - $(stat -c %Y "$CACHE_FILE") ))
  if (( age < CACHE_TTL )); then
    cat "$CACHE_FILE"
    exit 0
  fi
fi

fetch_json() {
  local url="$1"
  local remaining=$((DEADLINE - SECONDS))
  local response
  (( remaining > 0 )) || return 1
  response=$(curl -fsS --max-time "$remaining" --max-filesize "$MAX_RESPONSE_BYTES" "$url" | head -c "$((MAX_RESPONSE_BYTES + 1))") || return 1
  (( ${#response} <= MAX_RESPONSE_BYTES )) || return 1
  printf '%s' "$response"
}

if ! payload=$(fetch_json "$API"); then
  if [[ -f "$CACHE_FILE" ]]; then
    jq -c '.error = "offline"' "$CACHE_FILE"
  else
    printf '%s\n' '{"events":[],"error":"offline"}'
  fi
  exit 0
fi

result=$(jq -c --argjson maxEvents "$MAX_EVENTS" '
  def team($side):
    (($side.competitors // []) | map(select(.homeAway == "away")) | first // {}) as $away
    | (($side.competitors // []) | map(select(.homeAway == "home")) | first // {}) as $home
    | {
        away: {
          name: ($away.team.displayName // "Away"),
          abbrev: ($away.team.abbreviation // "AWAY"),
          logoUrl: ($away.team.logo // $away.team.logos[0].href // null),
          score: ($away.score // "0"),
          possession: ($away.possession // false)
        },
        home: {
          name: ($home.team.displayName // "Home"),
          abbrev: ($home.team.abbreviation // "HOME"),
          logoUrl: ($home.team.logo // $home.team.logos[0].href // null),
          score: ($home.score // "0"),
          possession: ($home.possession // false)
        }
      };

  def situation($value):
    if ($value | type) != "object" then null
    else {
      downDistanceText: ($value.downDistanceText // ""),
      shortDownDistanceText: ($value.shortDownDistanceText // ""),
      possessionText: ($value.possessionText // ""),
      down: ($value.down // null),
      distance: ($value.distance // null),
      yardLine: ($value.yardLine // null),
      isRedZone: ($value.isRedZone // false),
      lastPlay: ($value.lastPlay.text // "")
    } end;

  {
    events: [
      (.events // [] | if type == "array" then .[] else empty end)
      | select(
          type == "object"
          and (.id | type == "string" and test("^[0-9]{1,20}$"))
          and (.competitions[0].status.type.state == "in"
            or .competitions[0].status.type.state == "pre")
        )
      | (.competitions[0]) as $competition
      | (team($competition)) as $teams
      | {
          id: .id,
          state: ($competition.status.type.state // "pre"),
          date: (.date // ""),
          detail: ($competition.status.type.shortDetail // "LIVE"),
          broadcast: (($competition.broadcasts[0].names[0] // "") | tostring),
          situation: situation($competition.situation),
          away: $teams.away,
          home: $teams.home
        }
    ] | sort_by(.date) | .[:$maxEvents],
    fetchedAt: (now | strftime("%H:%M:%S"))
  }
' <<<"$payload") || {
  printf '%s\n' '{"events":[],"error":"invalid-response"}'
  exit 0
}

# The summary endpoint carries authoritative possession and situation data for
# live games, so enrich each event independently.
while IFS= read -r event_id; do
  [[ -n "$event_id" ]] || continue
  summary=$(fetch_json "$SUMMARY_API?event=$event_id" 2>/dev/null || true)
  [[ -n "$summary" ]] || continue
  possession=$(jq -c '
    [.header.competitions[0].competitors[]?
      | {abbrev: .team.abbreviation, possession: (.possession // false)}]
  ' <<<"$summary" 2>/dev/null || true)
  situation=$(jq -c '.header.competitions[0].situation // null' <<<"$summary" 2>/dev/null || printf '%s' null)
  [[ -n "$possession" ]] || continue
  result=$(jq -c --arg id "$event_id" --argjson possession "$possession" --argjson situation "$situation" '
    ($possession | map({key: .abbrev, value: .possession}) | from_entries) as $poss
    | .events = [
        .events[]
        | if .id != $id then .
          else .away.possession = ($poss[.away.abbrev] // false)
          | .home.possession = ($poss[.home.abbrev] // false)
          | .situation = (
              if ($situation | type) != "object" then .situation
              else {
                downDistanceText: ($situation.downDistanceText // ""),
                shortDownDistanceText: ($situation.shortDownDistanceText // ""),
                possessionText: ($situation.possessionText // ""),
                down: ($situation.down // null),
                distance: ($situation.distance // null),
                yardLine: ($situation.yardLine // null),
                isRedZone: ($situation.isRedZone // false),
                lastPlay: ($situation.lastPlay.text // "")
              } end
            )
          end
      ]
  ' <<<"$result")
done < <(jq -r '.events[] | select(.state == "in") | .id' <<<"$result")

printf '%s\n' "$result" > "$CACHE_FILE"
printf '%s\n' "$result"
