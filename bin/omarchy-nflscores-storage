#!/usr/bin/env python3

import json
import os
import secrets
import stat
import sys
import time


MAX_CACHE_BYTES = 131072
MAX_FAVORITES_BYTES = 4096
FAVORITES = {
    "ARI", "ATL", "BAL", "BUF", "CAR", "CHI", "CIN", "CLE",
    "DAL", "DEN", "DET", "GB", "HOU", "IND", "JAX", "KC",
    "LAC", "LAR", "LV", "MIA", "MIN", "NE", "NO", "NYG",
    "NYJ", "PHI", "PIT", "SF", "SEA", "TB", "TEN", "WSH",
}
FRESH_SECONDS = 30
DIRECTORY_FLAGS = os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW
FILE_FLAGS = os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK


class StorageError(Exception):
    pass


class CacheUnavailable(StorageError):
    pass


def get_path(kind):
    home = os.environ.get("HOME", "")
    if not os.path.isabs(home):
        raise StorageError("HOME must be an absolute path")
    if kind == "favorites":
        return os.path.join(home, ".local", "state", "omarchy", "settings", "nflscores.json")
    cache_home = os.environ.get("XDG_CACHE_HOME") or os.path.join(home, ".cache")
    if not os.path.isabs(cache_home):
        raise StorageError("XDG_CACHE_HOME must be an absolute path")
    return os.path.join(cache_home, "omarchy", "nflscores.json")


def open_parent(path, create=False):
    if not os.path.isabs(path) or "\0" in path:
        raise StorageError("storage path must be absolute")
    components = path.split("/")[1:]
    if not components or any(part in ("", ".", "..") for part in components):
        raise StorageError("invalid storage path")

    uid = os.getuid()
    fd = os.open("/", DIRECTORY_FLAGS)
    try:
        for component in components[:-1]:
            try:
                child = os.open(component, DIRECTORY_FLAGS, dir_fd=fd)
            except FileNotFoundError:
                if not create:
                    raise
                try:
                    os.mkdir(component, 0o700, dir_fd=fd)
                except FileExistsError:
                    pass
                child = os.open(component, DIRECTORY_FLAGS, dir_fd=fd)

            info = os.fstat(child)
            if not stat.S_ISDIR(info.st_mode) or info.st_uid not in (0, uid):
                os.close(child)
                raise StorageError("storage directory has unexpected type or owner")
            shared_sticky_directory = info.st_uid == 0 and info.st_mode & stat.S_ISVTX
            if info.st_mode & 0o022 and not shared_sticky_directory:
                os.close(child)
                raise StorageError("storage directory is writable by group or others")
            os.close(fd)
            fd = child

        info = os.fstat(fd)
        if info.st_uid != uid:
            raise StorageError("storage parent directory is not owned by current user")
        return fd, components[-1]
    except Exception:
        os.close(fd)
        raise


def check_file(fd, kind):
    info = os.fstat(fd)
    if not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid() or info.st_nlink != 1:
        raise StorageError("storage file must be an owned regular file without hard links")
    limit = MAX_FAVORITES_BYTES if kind == "favorites" else MAX_CACHE_BYTES
    if info.st_size > limit:
        raise StorageError("storage file exceeds size limit")
    return info


def read_file(parent_fd, name, kind):
    try:
        fd = os.open(name, FILE_FLAGS, dir_fd=parent_fd)
    except FileNotFoundError:
        return None, None
    try:
        info = check_file(fd, kind)
        limit = MAX_FAVORITES_BYTES if kind == "favorites" else MAX_CACHE_BYTES
        chunks = []
        remaining = limit + 1
        while remaining:
            chunk = os.read(fd, min(remaining, 16384))
            if not chunk:
                break
            chunks.append(chunk)
            remaining -= len(chunk)
        data = b"".join(chunks)
        if len(data) > limit:
            raise StorageError("storage file exceeds size limit")
        return data, info
    finally:
        os.close(fd)


def read_value(kind, stale=False):
    try:
        parent_fd, name = open_parent(get_path(kind))
    except FileNotFoundError:
        if kind == "favorites":
            return b'{"favorites":[]}\n'
        raise CacheUnavailable("cache file is unavailable")
    try:
        data, info = read_file(parent_fd, name, kind)
    finally:
        os.close(parent_fd)

    if data is None:
        if kind == "favorites":
            return b'{"favorites":[]}\n'
        raise CacheUnavailable("cache file is unavailable")

    if kind == "favorites":
        try:
            parsed = json.loads(data)
        except (UnicodeDecodeError, json.JSONDecodeError) as error:
            raise StorageError("favorites file contains invalid JSON") from error
        entries = parsed.get("favorites", []) if isinstance(parsed, dict) else []
        if not isinstance(entries, list):
            raise StorageError("favorites field must be an array")
        sanitized = []
        for team in entries:
            if isinstance(team, str) and team in FAVORITES and team not in sanitized:
                sanitized.append(team)
        return (json.dumps({"favorites": sanitized}, separators=(",", ":")) + "\n").encode()

    try:
        parsed = json.loads(data)
    except (UnicodeDecodeError, json.JSONDecodeError) as error:
        raise StorageError("cache file contains invalid JSON") from error
    if not isinstance(parsed, dict) or not isinstance(parsed.get("events"), list):
        raise StorageError("cache file has an invalid data shape")
    if not stale and time.time() - info.st_mtime >= FRESH_SECONDS:
        raise CacheUnavailable("cache file is stale")
    return data.rstrip(b"\n") + b"\n"


def write_value(kind, data):
    limit = MAX_FAVORITES_BYTES if kind == "favorites" else MAX_CACHE_BYTES
    if len(data) > limit:
        raise StorageError("storage content exceeds size limit")
    try:
        parsed = json.loads(data)
    except (UnicodeDecodeError, json.JSONDecodeError) as error:
        raise StorageError("storage content contains invalid JSON") from error

    if kind == "favorites":
        entries = parsed.get("favorites") if isinstance(parsed, dict) else None
        if not isinstance(entries, list) or any(not isinstance(team, str) or team not in FAVORITES for team in entries):
            raise StorageError("favorites content has an invalid shape")
        data = (json.dumps({"favorites": list(dict.fromkeys(entries))}, separators=(",", ":")) + "\n").encode()
    elif not isinstance(parsed, dict) or not isinstance(parsed.get("events"), list):
        raise StorageError("cache content has an invalid data shape")

    parent_fd, name = open_parent(get_path(kind), create=True)
    temporary = ".nflscores-" + secrets.token_hex(12)
    try:
        try:
            existing_fd = os.open(name, FILE_FLAGS, dir_fd=parent_fd)
        except FileNotFoundError:
            existing_fd = None
        if existing_fd is not None:
            try:
                check_file(existing_fd, kind)
            finally:
                os.close(existing_fd)

        fd = os.open(
            temporary,
            os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW,
            0o600,
            dir_fd=parent_fd,
        )
        try:
            with os.fdopen(fd, "wb", closefd=True) as output:
                output.write(data)
                output.flush()
                os.fsync(output.fileno())
            os.replace(temporary, name, src_dir_fd=parent_fd, dst_dir_fd=parent_fd)
            os.fsync(parent_fd)
        except Exception:
            try:
                os.unlink(temporary, dir_fd=parent_fd)
            except FileNotFoundError:
                pass
            raise
    finally:
        os.close(parent_fd)


def main(argv):
    if not argv:
        raise StorageError("operation is required")
    operation = argv[0]
    if operation == "read-favorites" and len(argv) == 1:
        sys.stdout.buffer.write(read_value("favorites"))
    elif operation == "write-favorites" and len(argv) == 2:
        write_value("favorites", argv[1].encode())
    elif operation in ("read-cache", "read-stale-cache") and len(argv) == 1:
        sys.stdout.buffer.write(read_value("cache", stale=operation == "read-stale-cache"))
    elif operation == "write-cache" and len(argv) == 1:
        data = sys.stdin.buffer.read(MAX_CACHE_BYTES + 1)
        write_value("cache", data)
    else:
        raise StorageError("unknown storage operation")
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except CacheUnavailable:
        sys.exit(3)
    except StorageError as error:
        print("nflscores-storage: " + str(error), file=sys.stderr)
        sys.exit(1)
    except OSError as error:
        print("nflscores-storage: secure file operation failed: " + str(error), file=sys.stderr)
        sys.exit(1)
